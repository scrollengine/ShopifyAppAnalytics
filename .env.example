# =============================================================================
#  shopify-app-analytics — environment for the Docker stack
# =============================================================================
#
#      cp .env.example .env
#
#  ...then fill in the REQUIRED block below. Nothing else needs touching.
#
#  This ONE file configures all three containers. docker-compose.yml passes it
#  to the backend and reads a couple of values itself; the dashboard needs no
#  configuration of its own, because it holds no credentials and learns
#  everything from the API.
#
#   `.env` IS A SECRET FILE — it holds your Partner API token, your admin
#  password and your JWT signing key. It must never be committed. Verify with
#  `git check-ignore .env` (silence means it is NOT ignored — add it).
#  It is never copied into an image either; both .dockerignore files exclude it.
#
#  Not using Docker? The backend reads the same variable names from
#  backend/.env, which documents the tuning knobs deliberately omitted here.
# =============================================================================


# =============================================================================
#  REQUIRED — the stack will not work until every one of these is filled in.
# =============================================================================

# ---- Shopify Partner API -----------------------------------------------------
# All three come from https://partners.shopify.com — this is the data source for
# every figure in the system.

# Your Partner ORGANISATION id: the number in the dashboard URL
#     https://partners.shopify.com/<THIS_NUMBER>/apps
# Not your app id, not your email.
SHOPIFY_PARTNER_ORG_ID=

# Partner API access token.
#     Partner dashboard -> Settings -> Partner API clients -> Manage / Create
# READ scopes are sufficient and are all this app can use: the client refuses to
# send any GraphQL document containing a mutation. Do not grant write scopes.
SHOPIFY_PARTNER_API_TOKEN=

# Which app to report on — the numeric id from that app's URL in the Partner
# dashboard. Every figure is scoped by it; there is no other tenancy concept.
SHOPIFY_PARTNER_APP_ID=

# The Partner API version this client speaks. It has a working default and you
# should normally leave it blank; it is listed because it is a TIER 1 key, so a
# blank-but-present line here is the documented way to see that it exists.
# Shopify retires versions on a schedule — when one is retired, bump this.
# Default: 2026-07
SHOPIFY_PARTNER_API_VERSION=

# ---- Dashboard login ---------------------------------------------------------
# One operator account, created on first boot. There is no signup flow and no
# user management screen; to change these, edit them here and restart.

# The email you type at the login screen.
ADMIN_EMAIL=

# The password you type at the login screen. Stored bcrypt-hashed, never in
# plaintext — but this file holds the plaintext, which is why it stays secret.
# Use something long; this login guards your revenue data.
ADMIN_PASSWORD=

# Optional, and PREFERRED over ADMIN_PASSWORD above: the bcrypt hash of that
# password. When both are set this one WINS. A plaintext password in the
# environment is readable in `ps` output, shell history and `docker inspect`;
# a hash is not. Generate one:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'your password'
# Leave blank to use ADMIN_PASSWORD instead. Do not set the hash here AND the
# plaintext in ADMIN_PASSWORD expecting the plaintext to win — it will not, and
# the validator refuses a hash placed in the plaintext variable and vice versa.
ADMIN_PASSWORD_HASH=

# Secret used to sign the dashboard's session JWTs. Any long random string.
# Changing it invalidates every issued session — which is exactly how you log
# everybody out.
#
# Generate a strong one (64 hex chars) with either:
#     openssl rand -hex 32
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Do not reuse a password here, and do not leave it at some memorable phrase.
JWT_SECRET=


# =============================================================================
#  PRE-FILLED FOR DOCKER — correct as they stand. Change only with a reason.
# =============================================================================

# Where the backend finds MongoDB. `mongo` is the compose SERVICE NAME, resolved
# on the private compose network — not a hostname your machine can look up.
#
# ⚠️ Never `localhost` here: inside the backend container localhost is the
# backend itself. (docker-compose.yml sets this value explicitly too, so the
# stack still works if you paste a local URI over it by accident.)
MONGO_URI=mongodb://mongo:27017/shopify_app_analytics

# Port the backend listens on INSIDE its container. It is not published to your
# host — the dashboard reaches it over the compose network — so this rarely
# needs changing. docker-compose.yml feeds it into the dashboard's proxy target
# below, so the two cannot drift apart.
PORT=8080

# Whose address the login rate limit counts against.
#
# ⚠️ SET THIS if you run the documented reverse-proxy / docker-compose topology.
# The dashboard proxies /api/* to this backend server-side, so this process's
# socket peer is ALWAYS the dashboard container — which means that with
# TRUST_PROXY unset, every login attempt on earth shares ONE bucket. Brute force
# is still stopped (it is stricter, not weaker), but one attacker can spend the
# whole budget and keep you out of your own login until the window rolls.
#
# TRUST_PROXY=uniquelocal fixes that: it trusts hops on loopback/private ranges,
# which is what the compose network and the nginx recipe in DEPLOYMENT.md are.
#
# The default is `false` because only ONE of the two failure directions is
# silent. Trusting by default would let any caller forge an X-Forwarded-For and
# mint a fresh bucket per request — disabling the limiter completely while it
# still looked switched on, with nothing in a log to say so. Counting the wrong
# address is loud and recoverable; a disabled control that reports itself as
# enabled is neither. The backend warns at every boot while this is unset.
#
# Accepts Express's own forms: false, true, a hop count (1), loopback,
# linklocal, uniquelocal, or a comma-separated list of addresses/CIDRs.
TRUST_PROXY=

# Where the dashboard proxies /api and /healthz.
#
#  `backend` is the compose SERVICE NAME and must stay that way. Inside the
# frontend container `localhost` is the FRONTEND, so http://localhost:8080 would
# reach nothing at all — this is the most common mistake with this stack.
#
# The browser never sees this value and never contacts the API directly: the
# dashboard proxies everything so there is one origin and no CORS to configure.
#
# docker-compose.yml sets this authoritatively as http://backend:${PORT}, so the
# line here is documentation of what the stack uses. Change it only if you are
# running the dashboard OUTSIDE compose against an API somewhere else.
NEXT_PUBLIC_API_BASE_URL=http://backend:8080


# =============================================================================
#  OPTIONAL — BigQuery / Shopify listing analytics.
# =============================================================================
#
#  WHAT THEY UNLOCK: the Traffic Sources views, and the TOP of the conversion
#  funnel — listing page views, engaged views and install clicks. That data comes
#  from Shopify's listing-analytics export in BigQuery, which the Partner API
#  does not expose.
#
#   THE APP RUNS FINE WITHOUT THEM. Leave all three blank and everything from
#  the install onward still works: installs, trials, conversions, MRR, cohorts
#  and churn. The views that need this data say they have no data — they do NOT
#  render zeros. An unavailable figure comes back null with a reason attached,
#  never as 0, which is the whole point of the project.
#
#  Nothing to install: `@google-cloud/bigquery` is a declared dependency and is
#  already in the backend image. These keys only decide whether it is USED.
# -----------------------------------------------------------------------------

# GCP project holding the exported dataset.
GCP_PROJECT_ID=

# Service-account key with BigQuery Job User + Data Viewer on the dataset below.
# Paste the downloaded JSON as a SINGLE LINE (the whole {...}, quotes included),
# or give an absolute path to the file — but note that a path must be readable
# INSIDE the container, so it needs a volume mount. The single-line JSON form is
# usually easier under Docker.
GCP_SERVICE_ACCOUNT_JSON=

# The dataset Shopify's listing analytics export writes into — typically the
# GA4-style `analytics_<propertyId>` dataset holding daily `events_*` tables.
BQ_DATASET=
