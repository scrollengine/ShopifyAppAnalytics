# =============================================================================
#  shopify-app-analytics — environment for the Docker stack
# =============================================================================
#
#      cp .env.example .env
#
#  ...then fill in the REQUIRED block below. Nothing else needs touching.
#
#  This ONE file configures all three containers. docker-compose.yml passes it
#  to the backend and reads a couple of values itself; the dashboard needs no
#  configuration of its own, because it holds no credentials and learns
#  everything from the API.
#
#   `.env` IS A SECRET FILE — it holds your Partner API token, your SMTP
#  password and your JWT signing key. It must never be committed. Verify with
#  `git check-ignore .env` (silence means it is NOT ignored — add it).
#  It is never copied into an image either; both .dockerignore files exclude it.
#
#  There is no password in this file for signing in. The first person to open
#  the dashboard creates the OWNER account on a setup screen, confirmed by an
#  emailed link; everyone else joins by emailed invitation. That is why the
#  mail settings below are required. DEPLOYMENT.md, step 5, walks through it.
#
#  Not using Docker? The backend reads the same variable names from
#  backend/.env, which documents the tuning knobs deliberately omitted here.
# =============================================================================


# =============================================================================
#  REQUIRED — the stack will not work until every one of these is filled in.
# =============================================================================

# ---- Shopify Partner API -----------------------------------------------------
# All three come from https://partners.shopify.com — this is the data source for
# every figure in the system.

# Your Partner ORGANISATION id: the number in the dashboard URL
#     https://partners.shopify.com/<THIS_NUMBER>/apps
# Not your app id, not your email.
SHOPIFY_PARTNER_ORG_ID=

# Partner API access token.
#     Partner dashboard -> Settings -> Partner API clients -> Manage / Create
# READ scopes are sufficient and are all this app can use: the client refuses to
# send any GraphQL document containing a mutation. Do not grant write scopes.
SHOPIFY_PARTNER_API_TOKEN=

# Which app to report on — the numeric id from that app's URL in the Partner
# dashboard. Every figure is scoped by it; there is no other tenancy concept.
SHOPIFY_PARTNER_APP_ID=

# The Partner API version this client speaks. It has a working default and you
# should normally leave it blank; it is listed because it is a TIER 1 key, so a
# blank-but-present line here is the documented way to see that it exists.
# Shopify retires versions on a schedule — when one is retired, bump this.
# Default: 2026-07
SHOPIFY_PARTNER_API_VERSION=

# ---- The dashboard's public address -------------------------------------------
# The address people type into a browser to reach the dashboard — scheme and
# host (and port, if not the default), with no path:
#     https://analytics.yourcompany.com
#     http://localhost:3000            (only you, on this machine, trying it out)
#
# EVERY LINK IN EVERY EMAIL is built from this and from nothing else — the setup
# confirmation, invitations, password resets. Never from the incoming request,
# whose Host header is written by whoever sends it.
#
# ⚠️ Not http://backend:8080. That is where the dashboard proxies to INSIDE the
# compose network; a link built from it opens nowhere. The backend warns at boot
# on that shape, on plain http:// to another machine, and on a localhost address
# (links then only open on this machine).
APP_PUBLIC_URL=

# ---- Outgoing mail (required) -------------------------------------------------
# Setup confirmation, invitations, password resets and "your password was
# changed" notices all go by email. There is deliberately no copy-this-link
# fallback in the dashboard. (Someone with shell access to the server can print
# a link with the recovery CLI instead — see DEPLOYMENT.md, "Account recovery".)
#
# GMAIL (a personal account is fine):
#   1. Turn on 2-Step Verification for the Google account.
#   2. Create an app password at https://myaccount.google.com/apppasswords
#      (16 letters, shown in four groups of four — paste it as shown; the spaces
#      are removed for smtp.gmail.com and nothing else).
#   3. Fill in:
#        SMTP_HOST=smtp.gmail.com
#        SMTP_PORT=465
#        SMTP_SECURE=true
#        SMTP_USER=you@gmail.com
#        SMTP_PASS=<the app password — NOT your Google account password>
#        SMTP_FROM=you@gmail.com
#   Changing the Google account password revokes every app password: mail stops
#   until you create a new one. Gmail allows about 500 recipients a day.
#   SETUP.md, section "Outgoing mail", has the full walkthrough.
#
# ANY OTHER SMTP SERVER — typically port 587 with STARTTLS:
#        SMTP_HOST=smtp.yourprovider.com
#        SMTP_PORT=587                 (leave SMTP_SECURE unset for 587)
#        SMTP_USER=<login>
#        SMTP_PASS=<password or API key>
#        SMTP_FROM=analytics@yourcompany.com
#
# ⚠️ A `$` in SMTP_PASS: Docker Compose expands `$NAME` in unquoted and
# double-quoted values of this file. Wrap the value in SINGLE quotes
# (SMTP_PASS='pa$sword') and it is used literally.

# The mail server's host name only — no scheme, no port (the port goes below).
SMTP_HOST=

# 465 with SMTP_SECURE=true (TLS from the first byte), or 587 with SMTP_SECURE
# unset (starts plain, then STARTTLS — which is REQUIRED; the connection is
# refused rather than sent in the clear). Unset, it follows SMTP_SECURE.
SMTP_PORT=
SMTP_SECURE=

# The login. Set both, or neither (a relay that accepts mail without a login).
# One without the other refuses to boot.
SMTP_USER=
SMTP_PASS=

# The sender ADDRESS — a bare address, no display name. Falls back to SMTP_USER
# when that is an email address; a relay that logs in as something else
# (SendGrid's login is literally "apikey") needs it set.
SMTP_FROM=

# The display name on the From line. Default: Shopify App Analytics
SMTP_FROM_NAME=

# ---- Sign-in -------------------------------------------------------------------

# Secret used to sign the dashboard's session JWTs. Any long random string.
# Changing it ends every session at once — everybody signs in again. (To sign
# out one person, use the Users page or the recovery CLI instead.)
#
# Generate a strong one (64 hex chars) with either:
#     openssl rand -hex 32
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Do not reuse a password here, and do not leave it at some memorable phrase.
JWT_SECRET=

# STRONGLY RECOMMENDED: the email address allowed to claim first-run setup.
#
# Until setup completes, the setup screen is open to whoever reaches the
# dashboard first, and they become the owner. Setting this closes that window:
# only this address can receive the confirmation email. Never printed in a log.
#
# Upgrading from the single-operator build? Unset, setup is restricted to the
# old ADMIN_EMAIL address(es) instead — set this if that was not a mailbox you
# can read.
SETUP_OWNER_EMAIL=

# Upgrading from the single-operator build: ADMIN_EMAIL, ADMIN_PASSWORD and
# ADMIN_PASSWORD_HASH are no longer read, and boot warns while they are set.
# Keep them until you are sure you will not roll back (the old build still needs
# them), then delete them. A rollback does not let the old build accept this
# build's sessions: they are signed with a key derived from JWT_SECRET, which
# the old build's check refuses. DEPLOYMENT.md, section "Upgrading from a
# single-operator build".


# =============================================================================
#  PRE-FILLED FOR DOCKER — correct as they stand. Change only with a reason.
# =============================================================================

# Where the backend finds MongoDB. `mongo` is the compose SERVICE NAME, resolved
# on the private compose network — not a hostname your machine can look up.
#
# ⚠️ Never `localhost` here: inside the backend container localhost is the
# backend itself. (docker-compose.yml sets this value explicitly too, so the
# stack still works if you paste a local URI over it by accident.)
MONGO_URI=mongodb://mongo:27017/shopify_app_analytics

# Port the backend listens on INSIDE its container. It is not published to your
# host — the dashboard reaches it over the compose network — so this rarely
# needs changing. docker-compose.yml feeds it into the dashboard's proxy target
# below, so the two cannot drift apart.
PORT=8080

# Whose address the ADDRESS-keyed rate limits count against: sign-in,
# forgot-password and the setup request. (The limit on the emailed-link pages
# is keyed on the link's token, not on an address, so this does not affect it.)
#
# ⚠️ LEAVE IT UNSET for the bundled stack as it stands (browser -> dashboard on
# port 3000 -> backend). The dashboard's /api proxy forwards a CALLER-SUPPLIED
# X-Forwarded-For unchanged, so trusting that header here would let any caller
# pick a fresh rate-limit bucket per request. Unset, every caller shares one
# bucket: the limits apply per DEPLOYMENT rather than per address — stricter,
# not weaker. A spent budget still admits one attempt every 30 seconds, and a
# browser that has signed in before gets a budget of its own, so a flood does
# not keep a returning user out; a first sign-in from a new browser waits on
# the shared bucket.
#
# SET TRUST_PROXY=uniquelocal only when the nginx recipe in DEPLOYMENT.md (or a
# proxy that appends or overwrites X-Forwarded-For the same way) sits in front
# AND the dashboard's port is bound to 127.0.0.1, so that proxy is the only way
# in. With it set, setup, password-reset and password-changed emails also name
# the address the request came from; unset, they leave that line out.
#
# The backend warns at every boot whichever way this is set, and the warning
# says which topology each choice is right for. Accepts Express's own forms:
# false, true, a hop count (1), loopback, linklocal, uniquelocal, or a
# comma-separated list of addresses/CIDRs.
TRUST_PROXY=

# Where the dashboard proxies /api and /healthz.
#
#  `backend` is the compose SERVICE NAME and must stay that way. Inside the
# frontend container `localhost` is the FRONTEND, so http://localhost:8080 would
# reach nothing at all — this is the most common mistake with this stack.
#
# The browser never sees this value and never contacts the API directly: the
# dashboard proxies everything so there is one origin and no CORS to configure.
#
# docker-compose.yml sets this authoritatively as http://backend:${PORT}, so the
# line here is documentation of what the stack uses. Change it only if you are
# running the dashboard OUTSIDE compose against an API somewhere else.
NEXT_PUBLIC_API_BASE_URL=http://backend:8080


# =============================================================================
#  OPTIONAL — BigQuery / Shopify listing analytics.
# =============================================================================
#
#  WHAT THEY UNLOCK: the Traffic Sources views, and the TOP of the conversion
#  funnel — listing page views, engaged views and install clicks. That data comes
#  from Shopify's listing-analytics export in BigQuery, which the Partner API
#  does not expose.
#
#   THE APP RUNS FINE WITHOUT THEM. Leave all three blank and everything from
#  the install onward still works: installs, trials, conversions, MRR, cohorts
#  and churn. The views that need this data say they have no data — they do NOT
#  render zeros. An unavailable figure comes back null with a reason attached,
#  never as 0, which is the whole point of the project.
#
#  Nothing to install: `@google-cloud/bigquery` is a declared dependency and is
#  already in the backend image. These keys only decide whether it is USED.
# -----------------------------------------------------------------------------

# GCP project holding the exported dataset.
GCP_PROJECT_ID=

# Service-account key with BigQuery Job User + Data Viewer on the dataset below.
# Paste the downloaded JSON as a SINGLE LINE (the whole {...}, quotes included),
# or give an absolute path to the file — but note that a path must be readable
# INSIDE the container, so it needs a volume mount. The single-line JSON form is
# usually easier under Docker.
GCP_SERVICE_ACCOUNT_JSON=

# The dataset Shopify's listing analytics export writes into — typically the
# GA4-style `analytics_<propertyId>` dataset holding daily `events_*` tables.
BQ_DATASET=
