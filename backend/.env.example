# =============================================================================
#  shopify-app-analytics-backend — environment
# =============================================================================
#
#  Copy to `.env` and fill in TIER 1. Nothing else is required to boot.
#
#      cp .env.example .env
#
#  Every value below is read in exactly ONE file — src/config/index.ts — and
#  consumed everywhere else as `config.<SECTION>.<FIELD>`. If you are adding a
#  setting, add it there; `process.env` is read nowhere else in the codebase.
#
# =============================================================================


# =============================================================================
#  TIER 1 — REQUIRED. The app will not start without these.
# =============================================================================

# MongoDB connection string. Anything mongoose accepts: a local mongod, a
# docker container, or an Atlas SRV URI. This is the only datastore — all
# history lives here, so point it somewhere you back up.
# Example (local):  mongodb://127.0.0.1:27017/shopify-app-analytics
MONGO_URI=

# Your Shopify Partner ORGANISATION id — the number in the Partner dashboard
# URL: https://partners.shopify.com/<THIS_NUMBER>/apps
# Not the app id, not your email.
SHOPIFY_PARTNER_ORG_ID=

# Shopify Partner API access token.
# Partner dashboard -> Settings -> Partner API clients -> Manage / Create.
# READ scopes are enough and are all this app ever uses: the Partner client is
# hard-wired read-only and rejects any GraphQL document containing a mutation
# before the request leaves the process. Do not grant write scopes.
SHOPIFY_PARTNER_API_TOKEN=

# Which of your apps to report on — the app's numeric id, from the app's URL in
# the Partner dashboard. Every figure in this system is scoped by this id; there
# is no other tenancy concept.
SHOPIFY_PARTNER_APP_ID=

# The Partner API version this client speaks. It has a working default and you
# should normally leave it blank; it is listed because it is a TIER 1 key, so a
# blank-but-present line here is the documented way to see that it exists.
# Shopify retires versions on a schedule — when one is retired, bump this.
# Default: 2026-07
SHOPIFY_PARTNER_API_VERSION=

# The single dashboard login. There is no signup flow and no user table to
# manage: one operator account, set here, created on first boot.
ADMIN_EMAIL=
# Stored hashed (bcrypt), never in plaintext, but this file holds the plaintext
# you type at the login screen — so keep .env out of version control (it is
# already in .gitignore) and use something long.
ADMIN_PASSWORD=

# Optional, and PREFERRED over ADMIN_PASSWORD above: the bcrypt hash of that
# password. When both are set this one WINS. A plaintext password in the
# environment is readable in `ps` output, shell history and `docker inspect`;
# a hash is not. Generate one:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'your password'
# Leave blank to use ADMIN_PASSWORD instead. Do not set the hash here AND the
# plaintext in ADMIN_PASSWORD expecting the plaintext to win — it will not, and
# the validator refuses a hash placed in the plaintext variable and vice versa.
ADMIN_PASSWORD_HASH=

# Secret used to sign the dashboard's JWTs. Any long random string; changing it
# invalidates every issued session, which is exactly how you log everyone out.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=


# =============================================================================
#  TIER 2 — OPTIONAL. BigQuery / Shopify listing analytics.
# =============================================================================
#
#  These unlock the TRAFFIC SOURCES views and the UPPER STEPS of the conversion
#  funnel — listing page views, engaged views and install clicks — which come
#  from Shopify's listing-analytics export in BigQuery rather than from the
#  Partner API.
#
#  THE APP RUNS FINE WITHOUT THEM. Leave them blank and everything from installs
#  onward still works: installs, trials, conversions, MRR, cohorts, churn. The
#  views that need this data report that they have no data — they do NOT show
#  zeros. An unavailable figure comes back as null with a reason attached, never
#  as 0. That is the point of the whole project.
#
#  The BigQuery client ships as a regular dependency, so `npm install` already
#  has it — there is nothing extra to install. Leaving this whole section blank
#  costs you the listing views and nothing else.
#
# -----------------------------------------------------------------------------

# GCP project that holds the exported dataset.
GCP_PROJECT_ID=

# Service-account credentials with BigQuery Job User + Data Viewer on the
# dataset below. Paste the downloaded key file's JSON as a SINGLE LINE (the
# whole {...} object, quotes and all), or give an absolute path to the file.
GCP_SERVICE_ACCOUNT_JSON=

# The dataset Shopify's listing analytics export writes into — typically the
# GA4-style `analytics_<propertyId>` dataset holding daily `events_*` tables.
BQ_DATASET=

# ---- Optional, for the BigQuery tier. Defaults are shown; delete to use them.

# The wildcard table the queries scan. `events_*` is GA4's own daily-export
# naming and is almost never worth changing.
# BQ_TABLE_PATTERN=events_*

# How far back a LIFETIME backfill reaches, as YYYY-MM-DD.
#
# This is a COST setting as much as a coverage one: BigQuery bills per byte
# SCANNED, and a lifetime run scans every daily table from this date forward.
# The GA4 export is forward-only and is never backfilled, so a floor earlier
# than the day you switched the export on buys nothing but scanned bytes.
# A malformed value is REFUSED at the start of a sync — an unparseable window
# returns zero rows rather than an error, which is worse than a failure.
# BQ_LIFETIME_FLOOR_DATE=2020-01-01

# How far back a routine (non-lifetime) BigQuery sync reaches, in days. Used
# only before the first successful sync; after that the watermark decides.
# BQ_LOOKBACK_DAYS=90

# When the two listing-analytics jobs run, UTC. Same two-form grammar as
# SYNC_DAILY_CRON — "m h * * *" or "m h * * <dow>", nothing else.
# The attribution job is deliberately later: it reads the same day's export and
# is a far heavier scan, so it is kept clear of the rollup hour.
# BIGQUERY_SYNC_CRON=0 2 * * *
# INSTALL_ATTRIBUTION_SYNC_CRON=0 6 * * *

# Hard per-query billing ceiling, in BYTES. Default 200 GiB. A query BigQuery
# estimates above this is REJECTED BEFORE IT RUNS and costs nothing — this is a
# spend limit, not a timeout.
# BQ_MAX_BYTES_BILLED=214748364800


# =============================================================================
#  TIER 3 — TUNABLES. Sensible defaults are already filled in; change only if
#  you have a reason. Every one of these can be deleted and the default applies.
# =============================================================================

# HTTP port the API listens on.
PORT=8080

# Which environment this is. Affects HOW LOUD THE LOGS ARE and nothing else that
# a client can see: thrown errors are redacted to their class before they reach
# the wire unconditionally, by src/middlewares/terminalErrorHandler.ts, precisely
# so that forgetting this line is never a disclosure.
#
# It does gate one check: with NODE_ENV=production, config validation WARNS at
# boot if SHOPIFY_PARTNER_API_BASE_URL is pointed somewhere other than Shopify —
# i.e. that every figure on the dashboard is coming from a fixture. It is a
# warning, not a refusal; the process still starts.
#
# Both Docker images already set `production`; this line matters when you run the
# process directly (`npm start`, systemd, pm2), where the default is
# `development`.
NODE_ENV=production

# Whose address the login rate limit counts against.
#
# ⚠️ THE ANSWER DEPENDS ON WHAT IS IN FRONT OF YOU, and the two cases are
# opposite. Set this ONLY if a real reverse proxy terminates requests in front of
# the stack.
#
#   LEAVE IT UNSET for the bundled docker-compose stack (browser -> dashboard on
#   port 3000 -> this backend). The dashboard's /api rewrite forwards a
#   CALLER-SUPPLIED X-Forwarded-For unchanged — it sets the header only when it
#   is absent and never appends the real peer — so trusting that header here
#   would let any caller pick their own rate-limit bucket and mint a fresh one
#   per request. Unset, every caller collapses to one bucket instead: the limit
#   becomes per-DEPLOYMENT rather than per-address, which is stricter, not
#   weaker, and is the correct trade when no address can be trusted.
#
#   SET TRUST_PROXY=uniquelocal when you run the nginx recipe in DEPLOYMENT.md,
#   or any proxy that sets `X-Forwarded-For` with nginx's
#   `$proxy_add_x_forwarded_for` (or overwrites it outright). That proxy appends
#   the REAL peer after anything the caller forged, so the rightmost non-private
#   entry is the true client and a forged entry to its left is ignored. Verified
#   against proxy-addr, both directions.
#
# The default is `false` because only ONE of the two failure directions is
# silent. Trusting when nothing overwrites the header disables the per-address
# limit completely while it still looks switched on, with nothing in a log to say
# so. Counting the wrong address is loud and recoverable; a disabled control that
# reports itself as enabled is neither.
#
# Either way you are not locked out: once a budget is spent the limiter still
# admits one attempt every 30 seconds, and a correct password on any of them
# clears the tally. See src/middlewares/loginRateLimit.ts.
#
# Accepts Express's own forms: false, true, a hop count (1), loopback,
# linklocal, uniquelocal, or a comma-separated list of addresses/CIDRs.
TRUST_PROXY=

# How recently a shop must have been billed a subscription charge to count as an
# ACTIVE PAID SUBSCRIBER. One 30-day billing cycle plus grace for payout timing.
#
# This number is load-bearing and it is a trade-off, not a preference. Too
# SHORT and a merchant whose payout settled late reads as churned — that is a
# real bug this project shipped once, producing a 47.6% churn figure for a month
# in which nobody actually cancelled. Too LONG and genuine cancellations that
# never sync stay "active" forever, which is the opposite failure. Widen it if
# your billing lands irregularly; do not remove the window entirely.
ACTIVE_SUB_WINDOW_DAYS=38

# When the nightly Partner API sync runs, as a cron expression in UTC.
# The scheduler is a plain setTimeout loop with no cron dependency, so it
# understands only two shapes:
#     "<minute> <hour> * * *"    daily      e.g. 0 3 * * *   = 03:00 UTC
#     "<minute> <hour> * * <dow>" weekly    e.g. 0 8 * * 1   = Mondays 08:00 UTC
# Ranges, lists, steps and day-of-month are NOT supported; anything else is
# rejected at boot rather than silently never firing.
SYNC_DAILY_CRON=0 3 * * *

# How far back a scheduled (incremental) Partner sync reaches, in days. The
# first sync of a fresh install ignores this and pulls your full history; this
# only bounds the nightly catch-up. Larger = slower sync, more API calls, more
# tolerance for events that arrive late.
SHOPIFY_PARTNER_LOOKBACK_DAYS=90

# Log verbosity: error | warn | info | debug
LOG_LEVEL=info
