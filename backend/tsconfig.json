{
    /* There is NO build step in normal operation.
       `npm start` runs the TypeScript directly through ts-node's transpile-only
       hook, so nothing is ever emitted next to a source file. `outDir` exists
       only so that an explicit `tsc` (should you ever want one) lands in dist/,
       which is gitignored — an in-place emit would leave a .js beside every .ts
       and Node resolves .js FIRST, so a stale artifact would silently shadow the
       source it came from. */
    "compilerOptions": {
        /* Language and environment */
        "target": "ES2022",
        "lib": ["ES2022"],

        /* Modules */
        "module": "commonjs",
        "rootDir": "./src",
        "resolveJsonModule": true,

        /* Emit (see the note above — not used by `npm start`) */
        "outDir": "./dist",
        "sourceMap": true,

        /* Interop.
           `esModuleInterop` is load-bearing here, not a preference: every module
           in this codebase ends in `export = { … }` so its shape stays a plain
           CommonJS object. TypeScript refuses a NAMED import from an export
           assignment (TS2497), so consumers use either
           `import x = require('./x')` or a default import — and the default
           import only type-checks with interop on. */
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,
        "allowJs": false,

        /* Type checking */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,

        /* Completeness */
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist", "test", "**/*.test.ts"],
    "ts-node": {
        "transpileOnly": true,
        "compilerOptions": {
            "module": "commonjs"
        }
    }
}
