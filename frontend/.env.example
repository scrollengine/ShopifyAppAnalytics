# =============================================================================
#  shopify-app-analytics-frontend — environment
# =============================================================================
#
#  Copy to `.env.local` and adjust if your backend is not on the default port:
#
#      cp .env.example .env.local
#
#  There is exactly ONE setting. The dashboard has no other configuration: it
#  holds no credentials, no app id and no partner token — those all live in the
#  backend's own .env, and the dashboard only ever sees what the API returns.
#
# =============================================================================

# Origin of the shopify-app-analytics BACKEND — scheme, host and port, no path.
#
# Read once, at boot, by next.config.js, which proxies `/api/*` and `/healthz`
# to it. The value is never compiled into the browser bundle and the browser
# never contacts this origin directly, which is why the dashboard has no CORS
# configuration to get wrong.
#
# Restart `next dev` after changing it — a rewrite is not hot-reloaded.
#
# Default when unset: http://localhost:8080  (the backend's own default PORT)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
